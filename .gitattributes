# Auto-detect text files
* text=auto eol=lf

# Force LF for code
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.tar.gz binary
*.zip binary

# Git LFS for large samples
benchmark/samples/seed_samples/**/*.js filter=lfs diff=lfs merge=lfs -text
benchmark/samples/seed_samples/**/*.json filter=lfs diff=lfs merge=lfs -text
