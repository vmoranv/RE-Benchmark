FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 build-essential libpq-dev && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY infra/docker/export_project_deps.py /tmp/export_project_deps.py
RUN python /tmp/export_project_deps.py pyproject.toml /tmp/requirements.txt && \
    pip install --no-cache-dir -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt /tmp/export_project_deps.py

COPY apps ./apps
COPY benchmark ./benchmark

RUN useradd --create-home --uid 1000 bench
USER bench

CMD ["celery", "-A", "apps.worker.celeryconfig:celery_app", "worker", "--loglevel=info", "-Q", "control,llm,metric,judge"]
