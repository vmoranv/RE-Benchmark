# Copy to `.env` and fill in your secrets. Never commit `.env`.

# Postgres
JSREBENCH_DATABASE_URL=postgresql+psycopg://bench:bench@localhost:5432/jsrebench

# Redis (Celery broker + cache + token bucket)
JSREBENCH_REDIS_URL=redis://localhost:6379/0

# Local artifact CAS
JSREBENCH_ARTIFACT_ROOT=./artifacts

# Sandbox profiles
JSREBENCH_SANDBOX_PROFILES_DIR=./infra/sandbox/profiles

# API host/port
JSREBENCH_API_HOST=0.0.0.0
JSREBENCH_API_PORT=8000

# Anthropic
JSREBENCH_ANTHROPIC_API_KEY=
JSREBENCH_ANTHROPIC_DEFAULT_MODEL=claude-opus-4-7-20260101

# Logging
JSREBENCH_LOG_LEVEL=INFO

# Blind test bundle (CI secret in production)
# JS_RE_BENCH_BLIND_BUNDLE=/path/to/decrypted-bundle.tar.gz
